# Lemma Observability Stack Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment

# Image Version Tags
GRAFANA_VERSION=11.1.0
PROMETHEUS_VERSION=v2.53.0
LOKI_VERSION=3.0.0
PROMTAIL_VERSION=3.0.0
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1

# Security and Credentials
GRAFANA_ADMIN_PASSWORD=admin

# Port Bindings Host Port mappings
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090
LOKI_PORT=3100
AI_PORT=8000

# Storage Retention and Scrape Configurations
PROMETHEUS_RETENTION_TIME=14d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=168h

# Backup Settings
BACKUP_RETENTION_DAYS=7

# Resource Boundaries CPU and Memory Limits
PROMETHEUS_MEM_LIMIT=1200M
PROMETHEUS_CPU_LIMIT=1.00

LOKI_MEM_LIMIT=1000M
LOKI_CPU_LIMIT=1.00

GRAFANA_MEM_LIMIT=400M
GRAFANA_CPU_LIMIT=0.50

AI_SERVICE_MEM_LIMIT=800M
AI_SERVICE_CPU_LIMIT=1.00

PROMTAIL_MEM_LIMIT=150M
PROMTAIL_CPU_LIMIT=0.40

CADVISOR_MEM_LIMIT=150M
CADVISOR_CPU_LIMIT=0.40

NODE_EXPORTER_MEM_LIMIT=50M
NODE_EXPORTER_CPU_LIMIT=0.20

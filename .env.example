# Lemma Observability Stack Configuration
# Copy this file to .env and adjust as necessary for your environment

# Image Versions
GRAFANA_VERSION=11.1.0
PROMETHEUS_VERSION=v2.53.0
LOKI_VERSION=3.0.0
PROMTAIL_VERSION=3.0.0
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1

# Resource Limits And Retention
PROMETHEUS_RETENTION_TIME=14d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=168h

# Port Bindings
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Lemma Observability Stack Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment

# Image Version Tags
GRAFANA_VERSION=11.1.0
PROMETHEUS_VERSION=v2.53.0
LOKI_VERSION=3.0.0
PROMTAIL_VERSION=3.0.0
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1

# Security and Credentials
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=https://sre-monitoring.thelunareix.my.id

# Port Bindings Host Port mappings
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Storage Retention and Scrape Configurations
PROMETHEUS_RETENTION_TIME=14d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=168h

# Backup Settings
BACKUP_RETENTION_DAYS=7

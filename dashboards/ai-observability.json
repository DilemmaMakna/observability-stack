        },
        "datasource": {
          "type": "loki",
          "uid": "Loki"
        },
        "definition": "label_values(service_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQuery",
          "stream": "",
          "type": 1
        },
        "refresh": 1,
        "regex": "/(.*backend.*|.*app.*|.*api.*|.*ai.*|.*llm.*|.*ollama.*)/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "name": "level",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {

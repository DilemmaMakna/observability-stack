{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Google SRE Golden Signal 1: Latency (LLM Gen & RAG Phase)",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "LLM Generation Latency Percentiles (P50, P90, P99)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.99, {job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.latency_seconds` [$__interval])",
          "legendFormat": "p99 LLM Latency",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.90, {job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.latency_seconds` [$__interval])",
          "legendFormat": "p90 LLM Latency",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.50, {job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.latency_seconds` [$__interval])",
          "legendFormat": "p50 LLM Latency (Median)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "RAG Document Retrieval Latency",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "avg(avg_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `rag_latency_seconds` [$__interval]))",
          "legendFormat": "Avg Retrieval Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "title": "Google SRE Golden Signal 2: Traffic (Token Volume & Financial Spend)",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Token Throughput (Input vs. Output Tokens)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(sum_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.input_tokens` [$__interval]))",
          "legendFormat": "Input Tokens",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(sum_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.output_tokens` [$__interval]))",
          "legendFormat": "Output Tokens",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Estimated Dollar Spend Trend (USD)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(sum_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.input_tokens` [$__interval])) * 0.0000015 + sum(sum_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.output_tokens` [$__interval])) * 0.000002",
          "legendFormat": "Estimated Spend ($)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 300,
      "title": "Google SRE Golden Signal 3: Errors (Failures, Timeouts & Tool Exceptions)",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 15 },
      "id": 5,
      "title": "AI Completion Error Count",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"docker-container-logs\", container=~\"$container\"} |~ \"error|fail|timeout\" [$__range])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 15 },
      "id": 6,
      "title": "Failed Tool Execution Rate",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | `gen_ai.tool_calls` != \"[]\" |~ \"error|fail\" [$__range])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      },
      "options": {
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 15 },
      "id": 7,
      "title": "Finish Reason Anomaly Count",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | `gen_ai.response.finish_reasons` != \"stop\" and `gen_ai.response.finish_reasons` != \"\" [$__range])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" }
        }
      },
      "options": {
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 400,
      "title": "Google SRE Golden Signal 4: Saturation (Context Window Limits & Provider Quotas)",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 8,
      "title": "Context Window Saturation (Avg tokens per call vs model limit)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "avg(avg_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.total_tokens` [$__interval]))",
          "legendFormat": "Avg Tokens per request",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 9,
      "title": "Active User Sessions & Tokens Usage per Session",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum by(container) (sum_over_time({job=\"docker-container-logs\", container=~\"$container\"} | json | unwrap `gen_ai.usage.total_tokens` [$__range]) + 1)",
          "legendFormat": "Session ID: {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 500,
      "title": "AI Logs & Transaction Trace Auditor",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "title": "Structured LLM Prompt Trace Log Stream",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{job=\"docker-container-logs\", container=~\"$container\", level=~\"$level\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "showLevel": true,
        "prettifyJson": true
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["ai", "llmops", "observability", "loki"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "Loki" },
        "definition": "label_values(container)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "label": "container",
          "refId": "LokiVariableQuery",
          "stream": "",
          "type": 1
        },
        "refresh": 1,
        "regex": "/(.*backend.*|.*app.*|.*api.*|.*ai.*|.*llm.*|.*ollama.*)/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "Loki" },
        "definition": "label_values(level)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "level",
        "options": [],
        "query": {
          "label": "level",
          "refId": "LokiVariableQuery",
          "stream": "",
          "type": 1
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": [ "5s", "10s", "30s", "1m", "5m" ]
  },
  "timezone": "browser",
  "title": "AI Observability Console",
  "uid": "ai_observability",
  "version": 1
}

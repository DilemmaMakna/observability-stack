// 1. Receive OTLP data (Metrics and Logs) over gRPC (4317) and HTTP (4318)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.metrics]
    logs    = [otelcol.processor.batch.default.logs]
  }
}

// 2. Batch telemetry data for transmission efficiency
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// 3. Convert OTLP metrics to Prometheus format
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}

// 4. Send metrics to Prometheus remote write receiver
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// 5. Convert OTLP logs to Loki format
otelcol.exporter.loki "default" {
  forward_to = [loki.write.local_loki.receiver]
}

// 6. Send logs to Loki write endpoint
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
